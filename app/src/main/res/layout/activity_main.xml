<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_premium"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/img_fondo_vacas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="1"
        android:contentDescription="Paisaje de vacas en la finca"
        android:scaleType="centerCrop"
        android:src="@drawable/vacas_pasto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_fondo_vacas_borroso"
        android:layout_width="0dp"
        android:layout_height="330dp"
        android:alpha="0.74"
        android:contentDescription="Fondo desenfocado"
        android:scaleType="centerCrop"
        android:src="@drawable/vacas_pasto"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_degradado_fondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_degradado_login"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scroll_inicio_sesion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ll_contenido_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="42dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/tv_logo_vacuno"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:contentDescription="Logo de Vacuno"
                android:scaleType="fitCenter"
                android:src="@drawable/a25de131_14db_4de1_a33b_656148a33694" />

            <TextView
                android:id="@+id/tv_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="VACUNO"
                android:textColor="@color/verde_principal"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gestion ganadera inteligente"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_inicia_sesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Bienvenido"
                android:textColor="@color/texto_principal"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_campo_texto"
                android:hint="Usuario"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/gris_hint"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_contrasena"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo_texto"
                android:hint="Contrasena"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/gris_hint"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_ingresar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@color/verde_botones"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_olvidaste_contrasena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#FFFFFF"
                android:backgroundTint="#59EFEDE4"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_crear_cuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_no_cuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#59EFEDE4"
                    android:text="¿Aún no tienes una cuenta?"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:id="@+id/tv_paisaje_finca"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginTop="0dp"
                android:contentDescription="Vacas comiendo pasto en una finca"
                android:scaleType="centerCrop"
                android:src="@drawable/vacas_pasto" />

            <TextView
                android:id="@+id/tv_crear_cuenta"
                android:layout_width="127dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="#59EFEDE4"
                android:text="Crear cuenta"
                android:textColor="@color/verde_oscuro"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
