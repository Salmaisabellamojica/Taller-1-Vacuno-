<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFCF9">

    <LinearLayout android:id="@+id/toolbar_inventario" android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="16dp" android:layout_marginTop="32dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="18dp"
        app:layout_constraintBottom_toTopOf="@+id/et_buscar_inventario" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/btn_volver_inventario" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Volver" android:gravity="center" android:text="‹" android:textColor="@color/texto_principal" android:textSize="40sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="@color/texto_principal" android:textSize="23sp" android:textStyle="bold" />
        <View android:layout_width="44dp" android:layout_height="44dp" />
    </LinearLayout>

    <EditText android:id="@+id/et_buscar_inventario" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" android:background="@drawable/bg_campo_texto" android:hint="Buscar producto o categoría" android:inputType="text" android:maxLines="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/texto_principal" android:textColorHint="@color/gris_hint" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar_inventario" />

    <HorizontalScrollView android:id="@+id/scroll_filtros_inventario" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="10dp" android:scrollbars="none" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/et_buscar_inventario">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_inventario_todos" style="@style/FiltroGanado" android:checked="true" android:text="Todos" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_vacunas" style="@style/FiltroGanado" android:text="Vacunas" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_desparasitantes" style="@style/FiltroGanado" android:text="Desparasitantes" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_sales" style="@style/FiltroGanado" android:text="Sales" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_alimentos" style="@style/FiltroGanado" android:text="Alimentos" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_otros" style="@style/FiltroGanado" android:text="Más" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView android:id="@+id/tv_inventario_vacio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No hay productos que coincidan con la búsqueda." android:textColor="@color/texto_secundario" android:textSize="15sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/scroll_filtros_inventario" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_inventario" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="20dp" android:layout_marginTop="24dp" android:layout_marginEnd="20dp" android:clipToPadding="false" android:paddingBottom="86dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/scroll_filtros_inventario" />
</androidx.constraintlayout.widget.ConstraintLayout>
