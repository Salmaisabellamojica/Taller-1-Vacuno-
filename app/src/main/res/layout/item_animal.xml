<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/bg_animal_card"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">

    <TextView android:id="@+id/tv_inicial" android:layout_width="92dp" android:layout_height="92dp"
        android:background="@drawable/bg_animal_imagen" android:gravity="center" android:textColor="@color/verde_principal"
        android:textSize="38sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_id" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_nombre" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/texto_principal" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_detalle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/texto_secundario" android:textSize="13sp" />
        <TextView android:id="@+id/tv_peso" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/texto_principal" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_estado" android:layout_width="wrap_content" android:layout_height="24dp"
            android:layout_marginTop="5dp" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
