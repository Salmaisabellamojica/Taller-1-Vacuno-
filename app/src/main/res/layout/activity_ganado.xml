<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_premium">

    <LinearLayout
        android:id="@+id/toolbar_ganado"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        app:layout_constraintBottom_toTopOf="@+id/et_buscar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_volver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Volver"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/white"
            android:textSize="40sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ganado"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <EditText android:id="@+id/et_buscar" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp"
        android:background="@drawable/bg_campo_texto" android:hint="Buscar por ID, nombre o raza" android:inputType="text" android:maxLines="1"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/texto_principal" android:textColorHint="@color/gris_hint"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar_ganado" />

    <HorizontalScrollView android:id="@+id/scroll_filtros" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="10dp" android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/et_buscar">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_todos"
                style="@style/FiltroGanado"
                android:background="#D9E7B4"
                android:checked="true"
                android:text="Todos"
                app:backgroundTint="#D9E7B4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hembras"
                style="@style/FiltroGanado"
                android:text="Hembras"
                app:backgroundTint="#D9E7B4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_machos"
                style="@style/FiltroGanado"
                android:text="Machos"
                app:backgroundTint="#D9E7B4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_jovenes"
                style="@style/FiltroGanado"
                android:text="Jóvenes"
                app:backgroundTint="#D9E7B4" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView android:id="@+id/tv_sin_resultados" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No hay animales que coincidan con la búsqueda."
        android:textColor="@color/texto_secundario" android:textSize="15sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/et_buscar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_animales"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:clipToPadding="false"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toTopOf="@id/ll_menu_ganado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_filtros"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/ll_menu_ganado"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_nav_premium"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button android:id="@+id/btn_inicio" style="@style/BotonMenu" android:text="Inicio" />
        <Button android:id="@+id/btn_menu_ganado" style="@style/BotonMenu" android:background="@drawable/bg_nav_item_active" android:text="Ganado" android:textColor="@color/verde_principal" />
        <Button android:id="@+id/btn_menu_inventario" style="@style/BotonMenu" android:text="Inventario" />
        <Button android:id="@+id/btn_menu_actividad" style="@style/BotonMenu" android:text="Actividad" />
        <Button android:id="@+id/btn_cerrar_sesio" style="@style/BotonMenu" android:text="Salir" android:textColor="@color/rojo_alerta" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
